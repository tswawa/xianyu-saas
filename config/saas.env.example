# Local development only. Copy to config/saas.env and keep that file untracked.
SAAS_ENV=development
# Never enable this in production; CI sets it explicitly for isolated tests.
SAAS_TESTING=0
SAAS_DB=.local/saas.db
SAAS_TENANTS_DIR=.local/tenants
SAAS_COOKIE_SECURE=0
# Optional loopback-only emergency operator token. Leave empty for normal role-based administration.
SAAS_ADMIN_TOKEN=
# Public origin used by browser write CSRF checks; keep it aligned with the
# externally visible site origin behind nginx or another reverse proxy.
SAAS_PUBLIC_ORIGIN=https://app.example.com
# Optional extra trusted Host headers for proxy/direct-developer setups.
SAAS_TRUSTED_HOSTS=app.example.com,127.0.0.1:8096
# Only trust forwarding headers from these reverse-proxy peers.
SAAS_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Deployment ceiling: production-safe default keeps public registration closed.
SAAS_ALLOW_REGISTRATION=0
SAAS_MAX_ACTIVE_SESSIONS=8
# Optional stable HMAC key for cross-restart audit source correlation; inject as a secret.
SAAS_AUDIT_HMAC_KEY=

# First-admin bootstrap is a separate one-time path and remains disabled by default.
# The token file must be an absolute 0600 file or a systemd credential basename.
SAAS_BOOTSTRAP_ENABLED=0
SAAS_BOOTSTRAP_TOKEN_FILE=
SAAS_BOOTSTRAP_TRUSTED_SOURCES=127.0.0.1,::1

SAAS_MAX_BOTS=3
SAAS_BOT_MEM_MB=400
SAAS_BOT_ROOT=./worker
SAAS_JOB_CONSUMER_POLL_SECONDS=1
SAAS_JOB_LEASE_SECONDS=180

# Platform-managed AI is optional in local development.
SAAS_PLATFORM_AI_BASE_URL=https://api.example.com/v1
SAAS_PLATFORM_AI_MODEL=your_model_name
SAAS_PLATFORM_AI_KEY=

# Account-scoped AI connection encryption. Keep the real value outside Git.
SAAS_AI_MASTER_KEY=
# Local-only HTTP/loopback exceptions are disabled by default.
SAAS_AI_ALLOW_HTTP_LOCAL=0
SAAS_AI_ALLOW_OLLAMA_LOCAL=0

# Browser log export defaults to off; use redacted only for trusted local diagnostics.
SAAS_BROWSER_LOGS_MODE=off

# Display prices can be changed per deployment; these are the product defaults.
SAAS_PLAN_DAY_PRICE=¥1
SAAS_PLAN_WEEK_PRICE=¥9
SAAS_PLAN_MONTH_PRICE=¥25
SAAS_PLAN_YEAR_PRICE=¥199
# Payment links remain empty until a merchant integration exists.
SAAS_PAYMENT_DAY_URL=
SAAS_PAYMENT_WEEK_URL=
SAAS_PAYMENT_MONTH_URL=
SAAS_PAYMENT_YEAR_URL=

# Conservative shop and QR-login limits.
SAAS_SHOP_SYNC_REQUEST_TIMEOUT_SECONDS=8
SAAS_SHOP_SYNC_MAX_SECONDS=55
SAAS_XIANYU_LOGIN_TTL_SECONDS=150
SAAS_XIANYU_LOGIN_CONFIRMED_TTL_SECONDS=90
SAAS_XIANYU_LOGIN_CAPACITY=16
SAAS_XIANYU_LOGIN_UPSTREAM_CONCURRENCY=2

# Signed GitHub Release updates. Repository and GitHub hosts are fixed in code;
# the browser cannot provide a URL or repository. Keep credentials outside Git.
SAAS_GITHUB_READ_TOKEN=
SAAS_UPDATE_PUBLIC_KEY_FILE=/etc/xianyu-saas/update-signing.pub
SAAS_CURRENT_ROOT=/opt/xianyu-saas/current
SAAS_RELEASES_DIR=/opt/xianyu-saas/releases
SAAS_UPDATE_STAGING_DIR=/var/lib/xianyu-saas/update-staging
SAAS_UPDATE_INTENT_FILE=/var/lib/xianyu-saas/update-intents/intent.json
SAAS_UPDATE_BACKUP_DIR=/var/lib/xianyu-saas/backups
SAAS_UPDATE_LOCK_FILE=/var/lib/xianyu-saas/updater.lock
SAAS_UPDATE_HEALTH_BASE_URL=http://127.0.0.1:8096/
SAAS_UPDATE_PUBLIC_BASE_URL=http://127.0.0.1/xianyu-saas/
