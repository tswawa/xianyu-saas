# Docker 部署配置示例。复制为 config/saas.env 后按需修改。
#
#   cp config/saas.env.docker.example config/saas.env
#
# 容器内服务绑定 0.0.0.0，由 compose 映射到宿主回环地址。
# 下面的来源配置必须与浏览器地址栏完全一致，否则登录等写请求会被拒绝。

SAAS_ENV=production
SAAS_TESTING=0

# 数据库与店铺目录位于数据卷内，不要改成容器外路径。
SAAS_DB=/data/saas.db
SAAS_TENANTS_DIR=/data/tenants

# 本地 HTTP 访问时保持 0；通过 HTTPS 反向代理发布时改为 1。
SAAS_COOKIE_SECURE=0

# 浏览器实际访问的地址。若从其他机器访问，改成该机器可见的地址。
SAAS_PUBLIC_ORIGIN=http://127.0.0.1:4173
SAAS_TRUSTED_HOSTS=127.0.0.1:4173,127.0.0.1:8096

SAAS_TRUSTED_PROXY_IPS=127.0.0.1,::1

# 后续 owner 注册的布尔开关（0 或 1）；设为 1 时仍需后台 registration_open 同时打开。
# 默认 bootstrap 关闭时，全新数据库允许首次网页注册管理员，不受此处 0 限制。
# 空站任何能访问者可抢先注册管理员，部署者应先注册再公开分享。
SAAS_ALLOW_REGISTRATION=0
SAAS_MAX_ACTIVE_SESSIONS=8

# 审计日志来源哈希密钥，留空则每次启动随机生成（重启后无法关联历史来源）。
SAAS_AUDIT_HMAC_KEY=

# 默认保持 0，首位管理员通过网页直接注册，无需令牌。
# 仅运维显式选择旧令牌 bootstrap 时置 1，此时不开放无令牌首次注册。
# 令牌文件需放在数据卷内并使用容器内路径；初始化后关闭开关并移除令牌。
SAAS_BOOTSTRAP_ENABLED=0
SAAS_BOOTSTRAP_TOKEN_FILE=
SAAS_BOOTSTRAP_TRUSTED_SOURCES=127.0.0.1,::1

# 同时运行的店铺 Worker 数量与单进程内存上限。
SAAS_MAX_BOTS=3
SAAS_BOT_MEM_MB=400
SAAS_BOT_ROOT=/app/worker

SAAS_JOB_CONSUMER_POLL_SECONDS=1
SAAS_JOB_LEASE_SECONDS=180

# 版本探测周期（秒），默认 21600（6 小时）。服务端后台异步探测，不自动安装。
# 若搭配 docker-compose.updates.yml 启用独立更新器，需在宿主环境变量或此文件中提供预装公钥路径：
# SAAS_UPDATE_PUBLIC_KEY_HOST_FILE=/etc/xianyu-saas/update-signing.pub
SAAS_UPDATE_CHECK_INTERVAL_SECONDS=21600

# 模型凭据加密主密钥，要求 32 字节随机二进制经标准 Base64 编码（44 字符，示例：base64.b64encode(os.urandom(32)).decode()）。
# 留空则首次启动在数据卷内生成，生产环境建议显式提供并妥善管理。
SAAS_AI_MASTER_KEY=

SAAS_AI_ALLOW_HTTP_LOCAL=0
SAAS_AI_ALLOW_OLLAMA_LOCAL=0
SAAS_BROWSER_LOGS_MODE=off

SAAS_SHOP_SYNC_REQUEST_TIMEOUT_SECONDS=8
SAAS_SHOP_SYNC_MAX_SECONDS=55
SAAS_XIANYU_LOGIN_TTL_SECONDS=150
SAAS_XIANYU_LOGIN_CONFIRMED_TTL_SECONDS=90
SAAS_XIANYU_LOGIN_CAPACITY=16
SAAS_XIANYU_LOGIN_UPSTREAM_CONCURRENCY=2
