[Unit]
Description=Xianyu SaaS application supervisor and built-in file updater
After=network-online.target
Wants=network-online.target
# The built-in launcher owns the consumer; stop the legacy consumer unit to
# avoid running two consumers for the same database.
Conflicts=xianyu-saas-consumer.service

[Service]
Type=simple
User=xianyu-saas
Group=xianyu-saas
WorkingDirectory=/opt/xianyu-saas/current/backend
EnvironmentFile=/etc/xianyu-saas.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/xianyu-saas/current/runtime/site/backend
Environment=SAAS_CURRENT_ROOT=/opt/xianyu-saas/current
Environment=SAAS_DEPLOYMENT_MODE=systemd
Environment=SAAS_RELEASE_KIND=standalone
Environment=SAAS_BOT_ROOT=/opt/xianyu-saas/current/worker
Environment=SAAS_BOT_PYTHON=/opt/xianyu-saas/current/runtime/python/bin/python3
Environment=SAAS_BOT_PYTHONPATH=/opt/xianyu-saas/current/runtime/site/worker
Environment=SAAS_UPDATE_PUBLIC_KEY_FILE=/etc/xianyu-saas/update-signing.pub
Environment=SAAS_UPDATE_INTENT_FILE=/var/lib/xianyu-saas-updates/intent.json
Environment=SAAS_UPDATE_STATUS_DIR=/var/lib/xianyu-saas-updates/status
# Immutable runtime/python and runtime/site packages stay outside the writable
# code store; updated application code is launched from the store.
Environment=SAAS_APP_CODE_DIR=/var/lib/xianyu-saas/app-code
Environment=SAAS_LAUNCH_BASE_ROOT=/opt/xianyu-saas/current
Environment=SAAS_LAUNCH_PYTHON=/opt/xianyu-saas/current/runtime/python/bin/python3
Environment=SAAS_LAUNCH_PYTHONPATH_EXTRA=/opt/xianyu-saas/current/runtime/site/backend
Environment=SAAS_LAUNCH_WORKER_PYTHON=/opt/xianyu-saas/current/runtime/python/bin/python3
Environment=SAAS_LAUNCH_WORKER_PYTHONPATH_EXTRA=/opt/xianyu-saas/current/runtime/site/worker
Environment=SAAS_LAUNCH_WEB=0
Environment=SAAS_LAUNCH_CONSUMER=1
Environment=SAAS_LAUNCH_CONFLICT_UNITS=xianyu-saas-consumer.service xianyu-saas-updater.service
ExecStart=/opt/xianyu-saas/current/docker/launcher.sh

Restart=on-failure
RestartSec=10
TimeoutStopSec=35
KillMode=control-group
UMask=0077
StateDirectory=xianyu-saas
StateDirectoryMode=0700
ReadWritePaths=/var/lib/xianyu-saas -/var/lib/xianyu-saas-updates

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
