[Unit]
Description=Xianyu SaaS API and managed bot supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xianyu-saas
Group=xianyu-saas
WorkingDirectory=/opt/xianyu-saas/current/backend
EnvironmentFile=/etc/xianyu-saas.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/xianyu-saas/current/runtime/site/backend
Environment=SAAS_CURRENT_ROOT=/opt/xianyu-saas/current
Environment=SAAS_DEPLOYMENT_MODE=systemd
Environment=SAAS_RELEASE_KIND=standalone
Environment=SAAS_BOT_ROOT=/opt/xianyu-saas/current/worker
Environment=SAAS_BOT_PYTHON=/opt/xianyu-saas/current/runtime/python/bin/python3
Environment=SAAS_BOT_PYTHONPATH=/opt/xianyu-saas/current/runtime/site/worker
Environment=SAAS_UPDATE_PUBLIC_KEY_FILE=/etc/xianyu-saas/update-signing.pub
Environment=SAAS_UPDATE_INTENT_FILE=/var/lib/xianyu-saas-updates/intent.json
Environment=SAAS_UPDATE_STATUS_DIR=/var/lib/xianyu-saas-updates/status
ExecStart=/opt/xianyu-saas/current/runtime/python/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8096 --proxy-headers --forwarded-allow-ips=127.0.0.1 --limit-concurrency 100 --backlog 128

Restart=on-failure
RestartSec=10
TimeoutStopSec=35
KillMode=control-group
UMask=0077
StateDirectory=xianyu-saas
StateDirectoryMode=0700
ReadWritePaths=/var/lib/xianyu-saas -/var/lib/xianyu-saas-updates

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
