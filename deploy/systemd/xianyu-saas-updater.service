[Unit]
Description=Xianyu SaaS signed release updater
After=local-fs.target network.target
RequiresMountsFor=/opt/xianyu-saas /var/lib/xianyu-saas /var/lib/xianyu-saas-updater /var/lib/xianyu-saas-updates
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/xianyu-saas.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SAAS_CURRENT_ROOT=/opt/xianyu-saas/current
Environment=SAAS_CURRENT_LINK=/opt/xianyu-saas/current
Environment=SAAS_RELEASES_DIR=/opt/xianyu-saas/releases
Environment=SAAS_STATE_DIR=/var/lib/xianyu-saas
Environment=SAAS_UPDATE_STAGING_DIR=/var/lib/xianyu-saas/update-staging
Environment=SAAS_UPDATE_INTENT_FILE=/var/lib/xianyu-saas-updates/intent.json
Environment=SAAS_UPDATER_STATE_DIR=/var/lib/xianyu-saas-updater
Environment=SAAS_RELEASE_KIND=standalone
Environment=SAAS_UPDATE_PUBLIC_KEY_FILE=/etc/xianyu-saas/update-signing.pub
Environment=SAAS_MANAGER_RELEASES_DIR=/opt/xianyu-saas/manager/releases
Environment=SAAS_MANAGER_CURRENT=/opt/xianyu-saas/manager/current
Environment=SAAS_MANAGER_EXECUTABLE=/opt/xianyu-saas/manager/current/xianyu-saas
ExecStart=/opt/xianyu-saas/manager/current/xianyu-saas internal consume-intent
StateDirectory=xianyu-saas-updater
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15min
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_SETUID CAP_SETGID
ReadWritePaths=/opt/xianyu-saas /var/lib/xianyu-saas /var/lib/xianyu-saas-updater /var/lib/xianyu-saas-updates
