[Unit]
Description=Xianyu SaaS durable job consumer
After=network-online.target xianyu-saas.service
Wants=network-online.target

[Service]
Type=simple
User=xianyu-saas
Group=xianyu-saas
WorkingDirectory=/opt/xianyu-saas/current/backend
EnvironmentFile=/etc/xianyu-saas.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SAAS_CURRENT_ROOT=/opt/xianyu-saas/current
ExecStart=/opt/xianyu-saas/runtime/backend-venv/bin/python -m job_consumer

Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillMode=control-group
UMask=0077
StateDirectory=xianyu-saas
StateDirectoryMode=0700
ReadWritePaths=/var/lib/xianyu-saas

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
